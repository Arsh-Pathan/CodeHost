{
  "name": "codehost",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "frontend",
    "backend",
    "billing",
    "database",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --no-daemon",
    "dev": "turbo run dev",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.8.11"
  }
}
