PUID=1000
PGID=1000
DOCKER_GID=999

# Database & Redis
DB_USER=codehost
DB_PASS=change_this_strong_postgres_password
DB_NAME=codehost
DATABASE_URL=postgresql://codehost:change_this_strong_postgres_password@postgres:5432/codehost?schema=public
REDIS_URL=redis://redis:6379

# Authentication Secrets (use two distinct random 32+ char strings)
JWT_SECRET=change_this_to_a_random_64_char_secret_key
JWT_REFRESH_SECRET=change_this_to_a_different_64_char_refresh_secret_key
TRUST_PROXY=1

# Domains & Reverse Proxy
DOMAIN=code-host.online
API_DOMAIN=api.code-host.online
APP_URL=https://code-host.online
API_URL=https://api.code-host.online
NEXT_PUBLIC_API_URL=https://api.code-host.online
LETSENCRYPT_EMAIL=admin@code-host.online

# Comma-separated bootstrap admin emails (promoted after email verification)
ADMIN_EMAILS=

# External OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP / Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Container Lifecycle
FREE_TIER_IDLE_MINUTES=30
ENABLE_DOCKER_STORAGE_OPT=false
